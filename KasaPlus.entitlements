<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Sign in with Apple yeteneği.

	  Bu dosya projeye BAĞLI DEĞİLDİR; böylece Apple Developer hesabı
	  tanımlanmadan da proje derlenip simülatörde çalışabilir.

	  Etkinleştirmek için (README → "Adım 1"):
	    Xcode → hedef "KasaPlus" → Signing & Capabilities → + Capability
	    → "Sign in with Apple"
	  Xcode bu dosyayı otomatik oluşturur/bağlar. Alternatif olarak
	  Build Settings → Code Signing Entitlements alanına
	  "KasaPlus.entitlements" yazabilirsiniz.
	-->
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
